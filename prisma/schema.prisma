// شرح: بعد أول نشر فعلي، القاعدة بقت PostgreSQL (Neon) بدل SQLite المحلية.
// للتطوير المحلي بدون الاتصال بالإنترنت، ينفع تسيب provider = "sqlite" وتغيّر DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Set {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tag         String // تصنيف السيت مثل "بوهيمي / دافئ"
  address     String   @default("18 شارع عزت سلامة، مدينة نصر، القاهرة")
  description String
  amenities   String // JSON array مخزنة كنص
  images      String // JSON array من مسارات الصور: ["/images/sets/xxx.jpg", ...]
  nameEn        String  @default("")
  tagEn         String  @default("")
  descriptionEn String  @default("")
  amenitiesEn   String  @default("[]") // JSON array بالإنجليزي
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]
}

// فئة الخدمة: بودكاست / ريلز / فوتوغرافي... كل فئة ليها معدات متضمنة ومستويات مدة
model PricingCategory {
  id        String   @id @default(cuid())
  key       String   @unique // "podcast", "reels", ...
  label     String // "بودكاست"
  includes  String // JSON array: ["لوكيشن","2 كاميرا",...]
  labelEn    String  @default("")
  includesEn String  @default("[]")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  tiers    PricingTier[]
  bookings Booking[]
}

model PricingTier {
  id         String @id @default(cuid())
  categoryId String
  hours      Int
  price      Float // السعر بعد الخصم
  original   Float // السعر قبل الخصم

  category PricingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, hours])
}

model Booking {
  id            String   @id @default(cuid())
  setId         String
  categoryId    String
  tierHours     Int
  customerName  String
  customerPhone String
  customerEmail String
  date          DateTime
  startTime     String
  price         Float
  depositAmount Float
  status        String   @default("pending_deposit")
  // pending_deposit -> pending_verification -> confirmed | cancelled
  paymentProofUrl String?
  couponCode      String?
  discountAmount  Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  set      Set             @relation(fields: [setId], references: [id])
  category PricingCategory @relation(fields: [categoryId], references: [id])

  @@index([setId, date])
}

// الفريق: صاحب الحساب + المديرين/الموديريتورز اللي بيتضافوا من لوحة التحكم
model TeamMember {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  isOwner      Boolean  @default(false)
  canBookings  Boolean  @default(true)
  canSets      Boolean  @default(false)
  canPricing   Boolean  @default(false)
  canTeam      Boolean  @default(false)
  canSettings  Boolean  @default(false)
  failedAttempts Int    @default(0)
  lockedUntil    DateTime?
  createdAt    DateTime @default(now())
}

// أيام/مواعيد بيقفلها الأدمن يدويًا (إجازة، صيانة...) — لو setId فاضي (null)
// يبقى اليوم مقفول بالكامل على كل السيتات، لو محدد يبقى مقفول لسيت واحد بس.
model BlockedSlot {
  id        String   @id @default(cuid())
  setId     String?
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([setId, date])
}

// صف واحد بس (id ثابت = "main") بيحمل إعدادات الموقع العامة القابلة للتعديل من لوحة التحكم
model SiteSettings {
  id             String  @id @default("main")
  whatsappNumber String  @default("201036263424")
  address        String  @default("18 شارع عزت سلامة، مدينة نصر، القاهرة")
  transferNumber String  @default("01005523731")
  instagramUrl   String?
  facebookUrl    String?
  tiktokUrl      String?
  instagramPosts String  @default("[]") // JSON array من لينكات بوستات انستجرام مختارة للعرض
}

// أكواد خصم يتحكم فيها الأدمن — نسبة أو مبلغ ثابت يتخصم من السعر قبل حساب الديبوزيت
model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String // "percent" أو "fixed"
  value       Float
  isActive    Boolean  @default(true)
  usageLimit  Int? // null = بلا حد أقصى
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
}

// قايمة انتظار: عميل مهتم بميعاد محجوز بالكامل، بيتبلغ لو الميعاد فضي
model WaitlistEntry {
  id            String   @id @default(cuid())
  setId         String
  date          DateTime
  customerName  String
  customerPhone String
  notified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([setId, date])
}
