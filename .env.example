# محلي: SQLite بملف واحد، مفيش اعدادات مطلوبة
DATABASE_URL="postgresql://neondb_owner:npg_q4zrdu7weLys@ep-ancient-night-ax2mdl23.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# للنشر الفعلي: استبدلها بـ connection string بتاع Postgres
# مثال (Vercel Postgres / Neon):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ⚠️ سيكريت توقيع جلسة الأدمن — لازم يبقى نص عشوائي طويل وقوي وقت النشر الفعلي
# (استخدم مثلاً: openssl rand -hex 32). لو اتسرب، أي حد يقدر يزوّر جلسة أدمن.
SESSION_SECRET="change-me-to-a-long-random-string"

# كلمة سر حساب صاحب الاستوديو الافتراضي (admin) — بتتستخدم مرة واحدة في الـ seed.
# غيّرها هنا قبل أول تشغيل لـ npm run db:seed، أو غيّرها من لوحة التحكم بعدين.
OWNER_PASSWORD="admin123"

# بوابة الدفع: دلوقتي الديبوزيت بيتحصل يدويًا عبر InstaPay (رقم ثابت في الكود).
# لما تحدد بوابة أوتوماتيكية (Paymob غالبًا الأنسب في مصر) ضيف مفاتيحها هنا.
PAYMENT_PROVIDER="instapay-manual"
PAYMENT_API_KEY=""
